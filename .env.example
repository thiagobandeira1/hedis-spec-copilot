# hedis-spec-copilot — local environment (copy to .env; NEVER commit .env)
#
# The API key is only needed for real-model paths (`hedis ask` with generation,
# `hedis eval --full`). Everything else — build, retrieval, `hedis eval --retrieval`,
# the Streamlit app in keyless degraded mode — runs without it. CI is keyless by design:
# no repository secret exists at all.
HEDIS_ANTHROPIC_API_KEY=sk-ant-...

# Optional: LangSmith tracing (env-gated; off by default).
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
